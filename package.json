{
  "name": "book-studio",
  "version": "2.2.0",
  "private": true,
  "description": "Read, write, annotate and print a book written in markdown. Open source, fully offline, no accounts.",
  "type": "module",
  "bin": {
    "book-studio": "bin/book-studio.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "electron .",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "icon": "electron scripts/make-icon.cjs",
    "notices": "node scripts/notices.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "pdfjs-dist": "5.6.205"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "mermaid": "12.3.0",
    "pagedjs": "0.4.3",
    "playwright-core": "1.64.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "main": "dist/app/main.mjs",
  "author": {
    "name": "Tabaré Lacerda",
    "url": "https://github.com/tlacerdap"
  },
  "license": "MIT",
  "homepage": "https://github.com/tlacerdap/book-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlacerdap/book-studio.git"
  },
  "bugs": {
    "url": "https://github.com/tlacerdap/book-studio/issues"
  },
  "keywords": [
    "markdown",
    "book",
    "pdf",
    "epub",
    "editor",
    "electron",
    "offline",
    "claude-code"
  ]
}
