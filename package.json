{
  "name": "book-studio",
  "version": "0.4.1",
  "private": true,
  "description": "Read, annotate and print a book written in markdown. Fully offline.",
  "type": "module",
  "bin": {
    "book-studio": "bin/book-studio.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "electron .",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "icon": "electron scripts/make-icon.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "pdfjs-dist": "5.6.205"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "pagedjs": "0.4.3",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "main": "dist/app/main.mjs",
  "author": {
    "name": "Tabaré Lacerda",
    "email": "lacerdatabare@gmail.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/tlacerdap/book-studio"
}
