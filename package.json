{
  "name": "book-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Read, annotate and print a book written in markdown. Fully offline.",
  "type": "module",
  "bin": {
    "book-studio": "bin/book-studio.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "electron .",
    "start": "npm run build && electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "electron": "45.2.1",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "5.6.205",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "main": "dist/app/main.mjs"
}
